# Server-only Supabase credentials. Never use a NEXT_PUBLIC_ prefix for these.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Required for production admin sessions; generate a separate random value (32+ chars).
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional initial admin password when no credential hash has been migrated yet.
ADMIN_PASSWORD=replace-with-a-unique-password
