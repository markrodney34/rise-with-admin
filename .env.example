# Required in production: admin login password (12+ characters recommended)
ADMIN_PASSWORD=replace-with-a-unique-password
# Required in production: random secret of at least 32 characters, independent from ADMIN_PASSWORD
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional: folder for editable content, messages and uploads (use a persistent disk in production)
# DATA_DIR=/var/data/rise
