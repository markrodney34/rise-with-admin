  "girls-soccer": {
   "name": "Girls Soccer",
   "img": "girls",
   "tag": "Girls division",
   "blurb": "An era of empowered girls: from netball to a girls soccer league.",
   "intro": "After four seasons of a netball league for girls, the calls were clear: girls wanted to play football and not be limited to netball. RISE listened and said yes.",
   "objectives": [
    "Promote community building and skills development",
    "Empower girls and attract attention and support for the league and local economic development",
